root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,props,targets,csproj,yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_prefer_braces = when_multiline:silent
dotnet_style_qualification_for_field = false:silent

# Diagnostics tuned for a compiler/runtime code base.
dotnet_diagnostic.CA1716.severity = none   # Identifiers like 'Sequence' / 'Set' are domain terms.
dotnet_diagnostic.CA1720.severity = none   # 'Integer', 'String' appear in ASN.1 terminology.
dotnet_diagnostic.CA1711.severity = none   # 'Collection' etc. suffixes are intentional.
dotnet_diagnostic.CA1710.severity = none
dotnet_diagnostic.CA1002.severity = none   # Generated and model types expose List<T> deliberately.
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1819.severity = none   # Byte arrays are the natural OCTET STRING representation.
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1305.severity = none   # Formatting is invariant (InvariantGlobalization=true).
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1031.severity = none   # Top-level CLI/diagnostic boundaries catch broadly by design.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1000.severity = none   # Static members on generic descriptor types are intended.
dotnet_diagnostic.CA1036.severity = none
dotnet_diagnostic.CA1815.severity = none
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1027.severity = none
dotnet_diagnostic.CA2225.severity = none
dotnet_diagnostic.CA1034.severity = none   # Nested types model nested ASN.1 types.
dotnet_diagnostic.CA1043.severity = none
dotnet_diagnostic.CA1508.severity = none
dotnet_diagnostic.CA1822.severity = silent
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1062.severity = none   # Nullable reference types cover argument null contracts.
dotnet_diagnostic.CA1021.severity = none
dotnet_diagnostic.CA1045.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1806.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA1003.severity = none
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1513.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1854.severity = none
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.CA1865.severity = none
dotnet_diagnostic.CA1847.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1864.severity = none
dotnet_diagnostic.CA1823.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = warning
