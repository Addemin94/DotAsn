<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The asn1 command-line tool: lint, check, generate-csharp, encode, decode, validate-message, inspect, standards and version.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>asn1</AssemblyName>
    <RootNamespace>Asn1.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>asn1</ToolCommandName>
    <PackageId>DotAsn.Cli</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Asn1.CodeGen.CSharp\Asn1.CodeGen.CSharp.csproj" />
    <ProjectReference Include="..\Asn1.CodeGen.TypeScript\Asn1.CodeGen.TypeScript.csproj" />
    <ProjectReference Include="..\Asn1.Dynamic\Asn1.Dynamic.csproj" />
    <ProjectReference Include="..\Asn1.Linter\Asn1.Linter.csproj" />
    <ProjectReference Include="..\Asn1.Serialization\Asn1.Serialization.csproj" />
  </ItemGroup>
</Project>
