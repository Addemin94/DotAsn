{
  "name": "@dotasn/runtime",
  "version": "0.2.1",
  "description": "Descriptors, value types and value notation for TypeScript generated by DotAsn; encoding is done by @dotasn/wasm.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Addemin94/DotAsn.git",
    "directory": "js/runtime"
  },
  "homepage": "https://github.com/Addemin94/DotAsn/tree/main/js/runtime#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dotasn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node --conditions=@dotasn/source --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "asn1",
    "asn.1",
    "codegen",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "^7.0.2"
  }
}
