{
  "name": "@dotasn/wasm",
  "version": "0.2.1",
  "description": "The DotAsn .NET runtime compiled to WebAssembly (NativeAOT-LLVM): BER, CER, DER, APER, UPER, OER, COER, JER, XER and CXER for TypeScript generated by DotAsn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Addemin94/DotAsn.git",
    "directory": "js/wasm"
  },
  "homepage": "https://github.com/Addemin94/DotAsn/tree/main/js/wasm#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dotasn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dotasn.wasm": "./lib/dotasn.wasm"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node --conditions=@dotasn/source --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "asn1",
    "asn.1",
    "ber",
    "der",
    "per",
    "uper",
    "oer",
    "jer",
    "xer",
    "wasm",
    "webassembly"
  ],
  "dependencies": {
    "@dotasn/runtime": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "^7.0.2"
  }
}
